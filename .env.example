# Pipeline Configuration & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO

# Storage
DATABASE_URL=sqlite+aiosqlite:///./pipeline.db
RAW_STORAGE_DIR=./data/raw

# Bulk Extraction Control Parameters
MAX_RECORDS=10
BULK_BATCH_SIZE=50
CRAWL_CONCURRENCY=5
RATE_LIMIT_PER_SECOND=2.0

# Environment-Driven LLM Model & Provider Configuration
LLM_PRIMARY_PROVIDER=GeminiFlash
LLM_PRIMARY_MODEL=gemini-2.5-flash
LLM_SECONDARY_PROVIDER=GroqLlama
LLM_SECONDARY_MODEL=groq/compound
LLM_TERTIARY_PROVIDER=DeepSeek
LLM_TERTIARY_MODEL=deepseek-chat

# LLM API Keys (Optional; if unconfigured, pipeline executes DOM/API parsing for live facts)
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# GitHub API Token (Optional, for live repo star count fetching)
GITHUB_TOKEN=

# Google Sheets Export (Optional)
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEET_ID=
