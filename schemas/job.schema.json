{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "JobEntity",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "source",
    "content",
    "collectedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "recordType": {
      "type": "string",
      "const": "JOB"
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "content": {
      "type": "object",
      "required": ["company", "date", "is_remote", "role_family"],
      "additionalProperties": false,
      "properties": {
        "jobTitle": {
          "type": ["string", "null"]
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date-time"
        },
        "is_remote": {
          "type": "boolean"
        },
        "role_family": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": ["string", "null"]
        },
        "descriptionSnippet": {
          "type": ["string", "null"]
        }
      }
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
