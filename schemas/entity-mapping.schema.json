{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "EntityMappingRecord",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "mappingId",
    "entityType",
    "rawValue",
    "normalizedValue",
    "canonicalValue",
    "matchMethod",
    "confidence",
    "timestamp",
    "sourceUrl",
    "resolverVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "recordType": {
      "type": "string",
      "const": "ENTITY_MAPPING"
    },
    "mappingId": {
      "type": "string"
    },
    "entityType": {
      "type": "string",
      "enum": ["STARTUP", "PRODUCT", "COMPANY"]
    },
    "rawValue": {
      "type": "string",
      "minLength": 1
    },
    "normalizedValue": {
      "type": "string",
      "minLength": 1
    },
    "canonicalValue": {
      "type": "string",
      "minLength": 1
    },
    "matchMethod": {
      "type": "string",
      "enum": [
        "SEED_EXACT",
        "ALIAS_LOOKUP",
        "FUZZY_JARO_WINKLER",
        "FUZZY_LEVENSHTEIN",
        "NEW_CANONICAL_SEED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sourceUrl": {
      "type": "string",
      "format": "uri"
    },
    "resolverVersion": {
      "type": "string"
    }
  }
}
