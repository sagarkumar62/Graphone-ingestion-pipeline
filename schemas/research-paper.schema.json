{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ResearchPaperEntity",
  "type": "object",
  "required": [
    "schemaVersion",
    "recordType",
    "source",
    "content",
    "collectedAt"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": ["1.0"]
    },
    "recordType": {
      "type": "string",
      "const": "RESEARCH_PAPER"
    },
    "source": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "content": {
      "type": "object",
      "required": [
        "title",
        "authors",
        "paper_url",
        "github_url",
        "github_stars",
        "published_date"
      ],
      "additionalProperties": false,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "authors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "paper_url": {
          "type": "string",
          "format": "uri"
        },
        "github_url": {
          "type": ["string", "null"]
        },
        "github_stars": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "published_date": {
          "type": "string",
          "format": "date-time"
        },
        "abstract": {
          "type": ["string", "null"]
        },
        "primaryCategory": {
          "type": ["string", "null"]
        }
      }
    },
    "collectedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
